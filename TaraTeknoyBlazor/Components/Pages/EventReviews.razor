@page "/events/{EventId:int}/review"
@rendermode InteractiveServer
@layout EmptyLayout

<div class="flex h-screen flex-col bg-white font-sans text-[#1F1F1F]">

    <!-- ===================== FIXED HEADER ===================== -->
    <header class="sticky top-0 z-10 flex-none bg-white px-8 pt-5">
        <div class="flex items-center justify-between">
            <img class="block h-[52px] w-auto" src="images/logo2.png" alt="Tara Teknoy" />

            <div class="flex items-center gap-5">
                <button class="inline-flex cursor-pointer items-center justify-center border-none bg-transparent p-1"
                        type="button" @onclick="OnSearchClicked" aria-label="Search">
                    <img class="block h-[26px] w-[26px]" src="images/search.png" alt="" />
                </button>
                <button class="inline-flex cursor-pointer items-center justify-center border-none bg-transparent p-1"
                        type="button" @onclick="OnProfileClicked" aria-label="Profile">
                    <img class="block h-[26px] w-[26px]" src="images/profile.png" alt="" />
                </button>
            </div>
        </div>
        <div class="mt-4 h-[3px] bg-[#F4C10F]"></div>
    </header>

    <!-- ===================== SCROLLABLE CONTENT ===================== -->
    <main class="flex-1 overflow-y-auto px-8 py-7">
        <div class="mx-auto max-w-2xl">

            <h1 class="m-0 mb-1 text-3xl font-extrabold">Rate this event</h1>
            <p class="m-0 mb-8 text-sm text-[#4A4A4A]">Event Title · Organization Name</p>

            <!-- ---------- Rating + comment form ---------- -->
            <div class="mb-10 rounded-2xl border border-[#E9E9E9] p-6">

                <!-- Star rating -->
                <div class="mb-6">
                    <p class="m-0 mb-2 text-sm font-semibold">Your rating</p>
                    <div class="flex items-center gap-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            var starValue = i;
                            <button type="button"
                                    class="h-9 w-9 cursor-pointer border-none bg-transparent p-0"
                                    @onclick="() => SelectRating(starValue)"
                                    @onmouseenter="() => hoverRating = starValue"
                                    @onmouseleave="() => hoverRating = 0"
                                    aria-label="Rate @starValue out of 5">
                                <svg class="h-full w-full @(starValue <= (hoverRating > 0 ? hoverRating : selectedRating) ? "text-[#F4C10F]" : "text-[#D9D9D9]")"
                                     viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2.5l2.9 6.2 6.6.7-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6-4.9-4.6 6.6-.7L12 2.5Z" />
                                </svg>
                            </button>
                        }
                        <span class="ml-2 text-sm font-semibold text-[#7A1E2B]">@RatingLabel</span>
                    </div>
                </div>

                <!-- Name (optional) -->
                <div class="mb-4">
                    <label class="mb-1 block text-sm font-semibold" for="reviewer-name">Name <span class="font-normal text-[#4A4A4A]">(optional)</span></label>
                    <input id="reviewer-name" @bind="reviewerName" type="text" placeholder="Anonymous"
                           class="w-full rounded-lg border border-[#E9E9E9] px-3.5 py-2.5 text-sm outline-none focus:border-[#7A1E2B]" />
                </div>

                <!-- Comment -->
                <div class="mb-6">
                    <label class="mb-1 block text-sm font-semibold" for="reviewer-comment">Comment</label>
                    <textarea id="reviewer-comment" @bind="commentText" rows="4" placeholder="Share your thoughts about this event..."
                              class="w-full resize-none rounded-lg border border-[#E9E9E9] px-3.5 py-2.5 text-sm outline-none focus:border-[#7A1E2B]"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p class="m-0 mb-4 text-sm text-red-600">@errorMessage</p>
                }

                <button type="button" @onclick="SubmitReview"
                        class="cursor-pointer rounded-lg border-none bg-[#7A1E2B] px-6 py-2.5 text-sm font-bold text-white transition-colors hover:bg-[#5C1620]">
                    Submit review
                </button>
            </div>

            <!-- ---------- Existing reviews ---------- -->
            <h2 class="m-0 mb-4 text-xl font-bold text-[#7A1E2B]">Reviews (@Reviews.Count)</h2>

            <div class="flex flex-col gap-4 pb-10">
                @foreach (var review in Reviews)
                {
                    <div class="rounded-xl border border-[#E9E9E9] p-4">
                        <div class="mb-1.5 flex items-center justify-between">
                            <span class="text-sm font-bold">@review.ReviewerName</span>
                            <span class="text-xs text-[#4A4A4A]">@review.PostedLabel</span>
                        </div>
                        <div class="mb-2 flex items-center gap-0.5">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <svg class="h-4 w-4 @(i <= review.Rating ? "text-[#F4C10F]" : "text-[#D9D9D9]")" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2.5l2.9 6.2 6.6.7-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6-4.9-4.6 6.6-.7L12 2.5Z" />
                                </svg>
                            }
                        </div>
                        <p class="m-0 text-sm leading-relaxed text-[#1F1F1F]">@review.Comment</p>
                    </div>
                }
            </div>

        </div>
    </main>
</div>

@code {
    [Parameter]
    public int EventId { get; set; }

    private int selectedRating = 0;
    private int hoverRating = 0;
    private string reviewerName = "";
    private string commentText = "";
    private string errorMessage = "";

    private List<ReviewModel> Reviews { get; set; } = new();

    private string RatingLabel => (hoverRating > 0 ? hoverRating : selectedRating) switch
    {
        1 => "Poor",
        2 => "Fair",
        3 => "Good",
        4 => "Very good",
        5 => "Excellent",
        _ => "Select a rating"
    };

    protected override void OnInitialized()
    {
        // TODO: replace with reviews loaded from your API / service layer, filtered by EventId.
        Reviews = new List<ReviewModel>
        {
            new("Miguel S.", 5, "Great turnout and well organized. Would attend again!", "2 days ago"),
            new("Anonymous", 4, "Good event overall, just wish it started on time.", "5 days ago"),
        };
    }

    private void SelectRating(int value)
    {
        selectedRating = value;
    }

    private void SubmitReview()
    {
        if (selectedRating == 0)
        {
            errorMessage = "Please select a star rating before submitting.";
            return;
        }

        var name = string.IsNullOrWhiteSpace(reviewerName) ? "Anonymous" : reviewerName.Trim();
        var comment = string.IsNullOrWhiteSpace(commentText) ? "(No comment provided.)" : commentText.Trim();

        Reviews.Insert(0, new ReviewModel(name, selectedRating, comment, "Just now"));

        // Reset form
        selectedRating = 0;
        hoverRating = 0;
        reviewerName = "";
        commentText = "";
        errorMessage = "";
    }

    private void OnSearchClicked() { /* TODO: open search */ }
    private void OnProfileClicked() { /* TODO: navigate to profile */ }

    public record ReviewModel(string ReviewerName, int Rating, string Comment, string PostedLabel);
}
